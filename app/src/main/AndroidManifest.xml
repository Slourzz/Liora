<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos de lectura de almacenamiento / audio -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Internet: solo para buscar las portadas que falten (iTunes), con copia
         local de 30 días. Sin conexión todo sigue funcionando. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Permisos para reproducción en segundo plano y notificación -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibración de las paradas (detentes) del slider de cristal -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".LioraApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.LioraAndroid">

        <!-- Actividad principal: ya no declara el filtro LAUNCHER,
             ese lo aportan los alias de icono de abajo. -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!-- ================= Selector de icono =================
             Cada alias es un acceso directo en el launcher con su
             propio icono. Solo uno esta habilitado a la vez y la app
             los conmuta con PackageManager.setComponentEnabledSetting.
             ==================================================== -->
        <activity-alias
            android:name=".icon.Glass"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.White"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_white"
            android:roundIcon="@mipmap/ic_launcher_white_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.Liora"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_liora"
            android:roundIcon="@mipmap/ic_launcher_liora_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.Outline"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_outline"
            android:roundIcon="@mipmap/ic_launcher_outline_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.Softblue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_softblue"
            android:roundIcon="@mipmap/ic_launcher_softblue_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Servicio de Media3 para reproducción en segundo plano -->
        <service
            android:name=".service.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
